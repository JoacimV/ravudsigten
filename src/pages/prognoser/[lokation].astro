---
// src/pages/prognoser/[lokation].astro
import Layout from "../../layouts/Layout.astro";
import strande from "../../resources/beaches-and-towns.json";
import LiveScore from "../../components/LiveScore.jsx";
import banner from "../../resources/images/banner.png";
import { createLocationSlug } from "../../utils/locationSlug.js";

export async function getStaticPaths() {
    const duplicateCounts = new Map<string, number>();

    for (const strand of strande) {
        const strandName: string = strand[0] as string;
        const existingCount = duplicateCounts.get(strandName) ?? 0;
        duplicateCounts.set(strandName, existingCount + 1);
    }

    const seenCounts = new Map<string, number>();

    return strande.map((strand) => {
        const strandName: string = strand[0] as string;
        const seenCount = seenCounts.get(strandName) ?? 0;
        seenCounts.set(strandName, seenCount + 1);
        const slug = createLocationSlug(strandName, seenCount, duplicateCounts.get(strandName) ?? 1);

        return {
            params: { lokation: slug },
            props: { strandInfo: strand },
        };
    });
}

const { strandInfo } = Astro.props;
const pageTitle = `Ravprognose for ${strandInfo[0]} – Chancer og kystvejr`;
const pageDescription = `Se den nyeste ravprognose for ${strandInfo[0]}. Tjek vindretning, strøm, temperatur og opskylsbetingelser i dag.`;

const [longitude, latitude] = strandInfo[2];
---

<Layout title={pageTitle} description={pageDescription}>
    <header class="hero is-link">
        <div class="hero-body">
            <div class="container">
                <h1 class="title">Ravprognose for {strandInfo[0]}</h1>
                <p class="subtitle">
                    Aktuelle kystforhold og chancer for at finde rav ved {
                        strandInfo[0]
                    }.
                </p>
            </div>
            <div class="is-fullwidth"></div>
        </div>
        <img
            src={banner.src}
            alt="Banner"
            style={{ objectFit: "cover", maxHeight: "400px" }}
        />
    </header>
    <main class="section">
        <div class="container">
            <LiveScore
                client:load
                longitude={longitude}
                latitude={latitude}
                name={strandInfo[0]}
            />
        </div>
    </main>
</Layout>
