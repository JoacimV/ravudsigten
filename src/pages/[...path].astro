---
// src/pages/[...path].astro
import Layout from "../layouts/Layout.astro";
import Header from "../layouts/Header.astro";
import strande from "../resources/beaches-and-towns.json";
import LiveScore from "../components/LiveScore.jsx";
import banner from "../resources/images/banner.png";
import { createLocationSlug } from "../utils/locationSlug.js";
import { locales } from "../paraglide/runtime.js";
import * as m from "../paraglide/messages.js";

export async function getStaticPaths() {
    const duplicateCounts = new Map<string, number>();

    for (const strand of strande) {
        const strandName = strand[0] as string;
        const existingCount = duplicateCounts.get(strandName) ?? 0;
        duplicateCounts.set(strandName, existingCount + 1);
    }

    const paths = [];

    for (const lang of locales) {
        const seenCounts = new Map<string, number>();

        for (const strand of strande) {
            const strandName = strand[0] as string;
            const seenCount = seenCounts.get(strandName) ?? 0;
            seenCounts.set(strandName, seenCount + 1);
            const slug = createLocationSlug(
                strandName,
                seenCount,
                duplicateCounts.get(strandName) ?? 1,
            );

            // da -> /prognoser/hundested
            // en -> /en/prognoser/hundested
            // de -> /de/prognoser/hundested
            // se -> /se/prognoser/hundested
            const routePath =
                lang === "da"
                    ? `prognoser/${slug}`
                    : `${lang}/prognoser/${slug}`;

            paths.push({
                params: { path: routePath },
                props: { strandInfo: strand, lang, slug },
            });
        }
    }

    return paths;
}

const { strandInfo, lang, slug } = Astro.props;

const [longitude, latitude] = strandInfo[2];

// Canonical URL & Hreflang URLs til SEO
const urls = [];

for (const locale of locales) {
    const url =
        locale === "da"
            ? `https://ravudsigten.dk/prognoser/${slug}`
            : `https://ravudsigten.dk/${locale}/prognoser/${slug}`;
    urls.push({ locale, url });
}
---

<Layout
    title={m.dark_noble_spider_pinch({ name: strandInfo[0] }, { locale: lang })}
    description={m.glad_game_swallow_sprout(
        { name: strandInfo[0] },
        { locale: lang },
    )}
    image={banner}
>
    <Fragment slot="head">
        {
            urls.map(({ locale, url }) => (
                <link rel="alternate" hreflang={locale} href={url} />
            ))
        }
        <link
            rel="alternate"
            hreflang="x-default"
            href={`https://ravudsigten.dk/en/prognoser/${slug}`}
        />
    </Fragment>
    <Header
        title={m.weary_cuddly_cuckoo_endure(
            { name: strandInfo[0] },
            { locale: lang },
        )}
        description={m.quaint_swift_hamster_revive(
            { name: strandInfo[0] },
            { locale: lang },
        )}
        image={banner}
    />
    <main class="section">
        <div class="container">
            <LiveScore
                client:load
                longitude={longitude}
                latitude={latitude}
                name={strandInfo[0]}
            />
        </div>
    </main>
</Layout>
