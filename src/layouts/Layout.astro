---
import { locales } from "../paraglide/runtime.js";
import * as m from "../paraglide/messages.js";
const siteUrl = "https://ravudsigten.dk";
let currentLang: "da" | "sv" | "en" | "de" = "da"; // default language
if (Astro.currentLocale) {
    currentLang = Astro.currentLocale as "da" | "sv" | "en" | "de";
}

const canonicalURL = new URL(Astro.url.pathname, siteUrl).href;
const ogLocaleMap: Record<string, string> = {
    da: "da_DK",
    en: "en_US",
    de: "de_DE",
    sv: "sv_SE",
};

const currentOgLocale = ogLocaleMap[currentLang];
const availableLocales = Object.values(locales);
const title = m.honest_bald_canary_expand(undefined, { locale: currentLang });
const description = m.dull_tidy_pelican_find(undefined, {
    locale: currentLang,
});
---

<!--text/html-->
<html lang={currentLang}>
    <head>
        <meta charset="UTF-8" />
        <meta
            name="viewport"
            content="width=device-width, initial-scale=1, viewport-fit=cover"
        />
        <title>{title}</title>
        <meta name="description" content={description} />
        <meta name="robots" content="index, follow" />
        <link rel="canonical" href={canonicalURL} />
        <!-- Open Graph -->
        <meta property="og:type" content="website" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonicalURL} />
        <meta
            property="og:image"
            content="https://ravudsigten.dk/og-image.png"
        />
        <meta property="og:locale" content={currentOgLocale} />

        {
            availableLocales.map((locale) => {
                return (
                    <meta
                        property="og:locale:alternate"
                        content={ogLocaleMap[locale]}
                    />
                );
            })
        }
        <link rel="alternate" hreflang="da" href={`${siteUrl}/`} />
        {
            availableLocales.map((locale) => {
                if (locale === "da") return null;
                return (
                    <link
                        rel="alternate"
                        hreflang={locale}
                        href={`${siteUrl}/${locale}`}
                    />
                );
            })
        }

        <link rel="alternate" hreflang="x-default" href={`${siteUrl}/en`} />
        <!-- Hvis du bruger Leaflet CSS fra CDN eller lokal fil -->
        <link
            rel="stylesheet"
            href="https://unpkg.com/leaflet/dist/leaflet.css"
        />
        <link
            rel="stylesheet"
            href="https://unpkg.com/react-leaflet-markercluster/dist/styles.min.css"
        />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Fira+Sans:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Roboto:ital,wght@0,100..900;1,100..900&display=swap"
            rel="stylesheet"
        />
        <link rel="stylesheet" href="/bulma.min.css" />
        <link rel="stylesheet" href="/App.css" />
        <link rel="sitemap" href="/sitemap-index.xml" />
        <!-- Astro generator -->
        <meta name="generator" content={Astro.generator} />
    </head>
    <body>
        <slot />
        <!-- Her indsættes indholdet fra siderne -->
    </body>
</html>
